# ─────────────────────────────────────────────────────────────────────────────
# NUBJobs — backend environment template
# Copy to `server/.env` and fill in real values (`cp server/.env.example server/.env`).
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nubjobs?schema=public"

# Auth
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="support@nubjobs.online"

# AI (Anthropic Claude)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"

# Cloudinary file uploads (dashboard → Settings → API Keys)
# Either provide the three credentials below, or a single CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-api-secret"
# CLOUDINARY_URL="cloudinary://000000000000000:your-api-secret@your-cloud-name"
# Legacy aliases are also supported: CLOUDINARY_NAME / CLOUDINARY_KEY / CLOUDINARY_SECRET

# Upload limits (MB) — enforced by Multer before anything reaches Cloudinary
MAX_IMAGE_UPLOAD_MB=5
MAX_DOCUMENT_UPLOAD_MB=5

# Server
PORT=5000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"
