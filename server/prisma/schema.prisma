

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION ()
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String
  role              Role      @default(STUDENT)
  isEmailVerified   Boolean   @default(false)
  isBanned          Boolean   @default(false)

  // Google OAuth ("Continue with Google")
  googleId          String?   @unique
  avatarUrl         String?   // picture from the Google profile
  provider          String    @default("local") // "local" | "google"

  // OTP for email verification
  otpCode           String?
  otpExpiry         DateTime?
  
  // OTP for password reset
  resetOtpCode      String?
  resetOtpExpiry    DateTime?
  
  // Profile relationships
  studentProfile    StudentProfile?
  employerProfile   EmployerProfile?
  
  // Messages & Notifications
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageRecipient")
  notifications     Notification[]
  eventRsvps        EventRsvp[]

  // Direct messaging (student <-> employer conversations)
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")
  blockingUsers      BlockedUser[]     @relation("BlockedBlocker")
  blockedByUsers     BlockedUser[]     @relation("BlockedTarget")
  messageDraftsSent  MessageDraft[]    @relation("DraftSender")
  messageDraftsGot   MessageDraft[]    @relation("DraftRecipient")

  // Events organized
  organizedEvents   CampusEvent[]

  // Admin panel: audit trail of every privileged action (spec: AuditLog)
  adminActions      AuditLog[]        @relation("AuditLogAdmin")
  // Admin tier: SUPER_ADMIN | CONTENT_MODERATOR | SUPPORT_TEAM
  // (only meaningful when role = ADMIN; defaults to SUPER_ADMIN)
  adminRole         String            @default("SUPER_ADMIN")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum Role {
  STUDENT
  EMPLOYER
  ADMIN
  MODERATOR
}

// ============================================
// STUDENT PROFILE 
// ============================================

model StudentProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Info
  photoUrl          String?
  phone             String?
  location          String?
  bio               String?
  department        String?
  nubId             String?   @unique
  
  // Academic Info
  cgpa              Float?
  skills            String[]  @default([])
  
  // URLs
  linkedinUrl       String?
  githubUrl         String?
  portfolioUrl      String?
  
  // Resume
  resumeUrl         String?
  
  // Relationships
  applications      Application[]
  savedJobs         SavedJob[]
  eventRsvps        EventRsvp[]
  disputes          Dispute[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ============================================
// EMPLOYER PROFILE 
// ============================================

model EmployerProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Company Info
  companyName           String
  about                 String?
  logoUrl               String?
  website               String?
  linkedinUrl           String?
  twitterUrl            String?
  facebookUrl           String?
  location              String?
  foundedYear           Int?
  employees             Int?
  industry              String?
  category              String?

  // Contact
  phone                 String?
  email                 String?

  // Verification ()
  isVerified            Boolean   @default(false)
  verificationDocument  String?
  verificationRequest   String?
  // Admin-panel verification pipeline: NONE | PENDING | APPROVED | REJECTED
  verificationStatus    String    @default("NONE")
  verifiedAt            DateTime?
  
  // Jobs
  jobs                  Job[]
  disputes              Dispute[]
  publishedAt           DateTime?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// ============================================
// JOBS 
// ============================================

model Job {
  id                String    @id @default(cuid())
  
  // Basic Info
  title             String
  description       String    @db.Text
  category          String?
  type              JobType   @default(FULL_TIME)
  location          String?
  
  // Salary
  salaryMin         Int?
  salaryMax         Int?
  
  // Requirements
  minCgpa           Float?
  skills            String[]  @default([])
  targetUniversity  String    @default("ALL") // ALL, NUB, OTHER
  deadline          DateTime?
  
  // Status ()
  status            JobStatus @default(ACTIVE) // DRAFT, PENDING, ACTIVE, CLOSED
  featured          Boolean   @default(false)
  publishedAt       DateTime?
  
  // Analytics ()
  views             Int       @default(0)
  applicantCount    Int       @default(0)
  
  // Relationships
  employerId        String
  employer          EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications      Application[]
  savedJobs         SavedJob[]
  // Direct messaging: conversations linked to this job posting
  conversations     Conversation[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PENDING
  ACTIVE
  CLOSED
  REJECTED
}

// ============================================
// APPLICATIONS ()
// ============================================

model Application {
  id                String    @id @default(cuid())
  
  // Relationships
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Application Details
  coverLetter       String?   @db.Text
  matchScore        Int       @default(0) // 0-100
  resumeUrl         String?   // snapshot of the student's resume at apply time
  
  // Status ()
  status            ApplicationStatus @default(APPLIED)
  notes             String?   @db.Text // Employer notes
  reviewedAt        DateTime? // first time the employer moved it past APPLIED
  
  // Interview (PROM)
  interviewDate     DateTime?
  interviewLink     String?
  
  // Messages & Chat ()
  messages          Message[]
  
  // Unique constraint: One application per student per job
  @@unique([jobId, studentId])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEWED
  HIRED
  REJECTED
  WITHDRAWN
}

// ============================================
// SAVED JOBS ()
// ============================================

model SavedJob {
  id                String    @id @default(cuid())
  
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  jobId             String
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@unique([studentId, jobId])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ============================================
// NOTIFICATIONS 
// ============================================

model Notification {
  id                String    @id @default(cuid())
  
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type              NotificationType
  message           String
  link              String?
  isRead            Boolean   @default(false)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_STATUS_UPDATE
  NEW_MESSAGE
  EVENT_REMINDER
  EVENT_NOTIFICATION
  JOB_ALERT
  JOB_APPROVED
  JOB_REJECTED
  COMPANY_VERIFIED
  COMPANY_VERIFICATION_REJECTED
  ACCOUNT_BANNED
  ACCOUNT_UNBANNED
  PASSWORD_RESET
  DISPUTE_UPDATE
  ADMIN_MESSAGE
}

// ============================================
// MESSAGES ()
// ============================================

model Message {
  id                String    @id @default(cuid())

  // Legacy application-scoped thread (kept working — optional so a Message can
  // instead belong to a direct student<->employer Conversation).
  applicationId     String?
  application       Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Direct messaging (spec: Conversation <-> Message)
  conversationId    String?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender
  senderId          String
  sender            User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Direct-messaging recipient (null for legacy application messages — the
  // recipient there is implied by the Application's parties).
  recipientId       String?
  recipient         User?     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Content
  content           String    @db.Text

  // Read Status ()
  isRead            Boolean   @default(false)
  readAt            DateTime?

  // Soft delete: keep the row for audit trail, hide it from clients
  isDeleted         Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId, createdAt])
  @@index([applicationId])
  @@index([senderId])
  @@index([recipientId])
}

// ============================================
// DIRECT MESSAGING (student <-> employer)
// ============================================

/// One row per participant pair. `user1Id < user2Id` is enforced in the
/// controller (canonical ordering) so a pair always maps to exactly one row
/// regardless of who initiated.
model Conversation {
  id                String    @id @default(cuid())

  user1Id           String
  user1             User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id           String
  user2             User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  // Optional job context — which posting this thread is about
  jobId             String?
  job               Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  lastMessage       String?   @db.Text
  lastMessageTime   DateTime  @default(now())

  // Per-user view flags (each side archives/pins independently)
  user1Archived     Boolean   @default(false)
  user2Archived     Boolean   @default(false)
  user1Pinned       Boolean   @default(false)
  user2Pinned       Boolean   @default(false)

  // Block state mirrored from BlockedUser for fast thread checks
  user1BlockedUser2 Boolean   @default(false)
  user2BlockedUser1 Boolean   @default(false)

  messages          Message[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageTime])
}

model BlockedUser {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("BlockedBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     User     @relation("BlockedTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

/// Draft auto-save per (sender, recipient) pair.
model MessageDraft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("DraftSender", fields: [userId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("DraftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, recipientId])
}

// ============================================
// CAMPUS EVENTS ()
// ============================================

model CampusEvent {
  id                String    @id @default(cuid())
  
  title             String
  description       String    @db.Text
  eventDate         DateTime
  location          String
  
  // Capacity & Eligibility
  capacity          Int?      // Max attendees
  minCgpa           Float?    // Minimum CGPA requirement
  
  imageUrl          String?
  registrationLink  String?
  
  // Organizer
  organizerId       String
  organizer         User      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  
  // RSVPs
  rsvps             EventRsvp[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ============================================
// EVENT RSVPs ()
// ============================================

model EventRsvp {
  id                String    @id @default(cuid())
  
  eventId           String
  event             CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Unique constraint: One RSVP per student per event
  @@unique([eventId, studentId])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ============================================
// ADMIN PANEL — AUDIT LOG, DISPUTES, SETTINGS
// ============================================

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AuditLogAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  adminName    String
  action       String   // approve_job, reject_job, ban_user, verify_company, ...
  resourceType String   // job, user, company, application, dispute, setting
  resourceId   String?
  details      String?  @db.Text
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Dispute {
  id          String   @id @default(cuid())
  type        String   @default("OTHER") // GHOSTING, MISLEADING_JOB, COMMUNICATION, PAYMENT, OTHER
  title       String?
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, RESOLVED, CLOSED

  reporterId  String?
  studentId   String?
  student     StudentProfile?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  employerId  String?
  employer    EmployerProfile? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  jobId       String?
  applicationId String?

  action      String?  // WARN_STUDENT, WARN_EMPLOYER, BAN_STUDENT, BAN_EMPLOYER, REFUND, OTHER, NONE
  resolution  String?  @db.Text
  resolvedAt  DateTime?
  resolvedBy  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedBy String?
  updatedAt DateTime @updatedAt
}

